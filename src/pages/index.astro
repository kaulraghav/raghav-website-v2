---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blogPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .map(p => ({ ...p, type: 'blog', date: p.data.date, href: `/blog/${p.id}/` }));

const musicPosts = (await getCollection('music'))
  .map(p => ({ ...p, type: 'music', date: p.data.date, href: `/music/#${p.id}` }));

const galleryItems = (await getCollection('gallery'))
  .map(p => ({ ...p, type: 'gallery', date: p.data.date, href: `/gallery/#${p.id}` }));

const allItems = [...blogPosts, ...musicPosts, ...galleryItems]
  .sort((a, b) => b.date.getTime() - a.date.getTime());

const grouped = allItems.reduce<Record<string, typeof allItems>>((acc, item) => {
  const key = item.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  if (!acc[key]) acc[key] = [];
  acc[key].push(item);
  return acc;
}, {});

const typeLabel: Record<string, string> = { blog: 'Post', music: 'Music', gallery: 'Photo' };
---

<BaseLayout title="Raghav Kaul" description="Personal website — blog, music, photography">
  <div class="container">
    <div class="layout-with-sidebar">
      <div class="main-content">
        <h1 class="page-heading">Activity</h1>
        <p class="page-subheading">Everything, newest first.</p>

        {Object.entries(grouped).map(([month, items]) => (
          <section class="feed-section">
            <div class="feed-month">{month}</div>
            {items.map(item => (
              <div class="feed-item">
                <div class="feed-date">
                  {item.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                </div>
                <div>
                  <div class="feed-type-badge">{typeLabel[item.type]}</div>
                  <div class="feed-item-title">
                    <a href={item.href}>{item.data.title}</a>
                  </div>
                  {'description' in item.data && item.data.description && (
                    <div class="feed-item-desc">{item.data.description}</div>
                  )}
                  {'caption' in item.data && (
                    <div class="feed-item-desc">{item.data.caption}</div>
                  )}
                </div>
              </div>
            ))}
          </section>
        ))}

        {allItems.length === 0 && (
          <p style="color: var(--color-muted)">No posts yet — check back soon.</p>
        )}
      </div>

      <aside class="sidebar">
        <div class="sidebar-section">
          <div class="sidebar-heading">About</div>
          <p style="font-size:0.9rem; color: var(--color-muted); line-height: 1.6">
            Software developer based in Tempe. I write, make music, and take photos.
          </p>
        </div>
        <div class="sidebar-section">
          <div class="sidebar-heading">Browse</div>
          <ul class="sidebar-list">
            <li><a href="/blog/">Blog</a></li>
            <li><a href="/music/">Music</a></li>
            <li><a href="/gallery/">Gallery</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

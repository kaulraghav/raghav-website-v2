---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Raghav Kaul`} description={post.data.description}>
  <div class="container">
    <div class="post-header">
      <p style="font-size:0.85rem; color: var(--color-muted); margin-bottom: 0.75rem">
        <a href={`${base}blog/`} style="text-decoration:none">← Blog</a>
      </p>
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <span>{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        {post.data.tags.map(tag => (
          <a href={`${base}blog/?tag=${tag}`} class="tag">#{tag}</a>
        ))}
      </div>
    </div>

    <article class="post-body">
      <Content />
    </article>

    <div id="likes-mount"></div>
  </div>
</BaseLayout>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.min.js"></script>
<script>
(async function () {
  const SUPABASE_URL = 'https://yjgthlmkjjqjnsmciczg.supabase.co';
  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InlqZ3RobG1rampxam5zbWNpY3pnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzg0MzQ5NTksImV4cCI6MjA5NDAxMDk1OX0.kEsKNgAXMt-wJZrGOx-65__d1qhg0yCr7y4r70w02tY';
  const mount = document.getElementById('likes-mount');
  if (!mount) return;

  // Show a disabled placeholder until Supabase credentials are added
  if (SUPABASE_URL === 'YOUR_SUPABASE_URL') {
    mount.innerHTML = `
      <div id="like-container">
        <button id="like-btn" disabled style="opacity:0.4; cursor:not-allowed">
          <span>♡</span>
          <span>0</span>
        </button>
        <span id="like-auth-msg">Likes coming soon</span>
      </div>`;
    return;
  }

  const sb = (window as any).supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
  const slug = window.location.pathname.replace(/^\/|\/$/g, '') || 'home';
  const { data: { session } } = await sb.auth.getSession();
  const user = session?.user ?? null;
  const { data: likes } = await sb.from('likes').select('user_id').eq('post_slug', slug);
  const count = likes?.length ?? 0;
  const hasLiked = user ? likes?.some((l: any) => l.user_id === user.id) : false;

  mount.innerHTML = `
    <div id="like-container">
      <button id="like-btn" class="${hasLiked ? 'liked' : ''}">
        <span id="like-icon">${hasLiked ? '♥' : '♡'}</span>
        <span id="like-count">${count}</span>
      </button>
      ${!user ? '<span id="like-auth-msg">Sign in with Google to like this post</span>' : ''}
    </div>`;

  document.getElementById('like-btn')!.addEventListener('click', async () => {
    if (!user) {
      await sb.auth.signInWithOAuth({ provider: 'google', options: { redirectTo: window.location.href } });
      return;
    }
    const btn = document.getElementById('like-btn')!;
    const icon = document.getElementById('like-icon')!;
    const countEl = document.getElementById('like-count')!;
    const alreadyLiked = btn.classList.contains('liked');
    if (alreadyLiked) {
      await sb.from('likes').delete().match({ post_slug: slug, user_id: user.id });
    } else {
      await sb.from('likes').insert({ post_slug: slug, user_id: user.id });
    }
    btn.classList.toggle('liked');
    icon.textContent = alreadyLiked ? '♡' : '♥';
    countEl.textContent = String(parseInt(countEl.textContent!) + (alreadyLiked ? -1 : 1));
  });
})();
</script>

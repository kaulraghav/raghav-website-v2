---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const activeTag = Astro.url.searchParams.get('tag') ?? '';
const filtered = activeTag ? posts.filter(p => p.data.tags.includes(activeTag)) : posts;

const allTags = [...new Set(posts.flatMap(p => p.data.tags))].sort();

const grouped = filtered.reduce<Record<string, typeof filtered>>((acc, post) => {
  const key = post.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  if (!acc[key]) acc[key] = [];
  acc[key].push(post);
  return acc;
}, {});

const monthCounts = posts.reduce<Record<string, number>>((acc, post) => {
  const key = post.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
  acc[key] = (acc[key] ?? 0) + 1;
  return acc;
}, {});
---

<BaseLayout title="Blog — Raghav Kaul" description="Writing on software, life, and everything in between.">
  <div class="container">
    <div class="layout-with-sidebar">
      <div class="main-content">
        <h1 class="page-heading">Blog</h1>
        <p class="page-subheading">
          {posts.length} post{posts.length !== 1 ? 's' : ''}
          {activeTag && <> tagged <strong>#{activeTag}</strong></>}
        </p>

        <div class="tag-list">
          <a href={`${base}blog/`} class={`tag ${!activeTag ? 'active' : ''}`}>All</a>
          {allTags.map(tag => (
            <a href={`${base}blog/?tag=${tag}`} class={`tag ${activeTag === tag ? 'active' : ''}`}>
              #{tag}
            </a>
          ))}
        </div>

        {Object.entries(grouped).map(([month, items]) => (
          <section class="feed-section">
            <div class="feed-month">{month}</div>
            {items.map(post => (
              <div class="feed-item">
                <div class="feed-date">
                  {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                </div>
                <div>
                  <div class="feed-item-title">
                    <a href={`${base}blog/${post.id}/`}>{post.data.title}</a>
                  </div>
                  {post.data.description && (
                    <div class="feed-item-desc">{post.data.description}</div>
                  )}
                  <div class="tag-list" style="margin-top: 0.4rem; margin-bottom: 0">
                    {post.data.tags.map(tag => (
                      <a href={`${base}blog/?tag=${tag}`} class="tag">#{tag}</a>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </section>
        ))}

        {filtered.length === 0 && (
          <p style="color: var(--color-muted)">No posts found.</p>
        )}
      </div>

      <aside class="sidebar">
        <div class="sidebar-section">
          <div class="sidebar-heading">Tags</div>
          <ul class="sidebar-list">
            {allTags.map(tag => (
              <li>
                <a href={`${base}blog/?tag=${tag}`} class={activeTag === tag ? 'active' : ''}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="sidebar-section">
          <div class="sidebar-heading">Archive</div>
          <ul class="sidebar-list">
            {Object.entries(monthCounts).map(([month, count]) => (
              <li>
                <a href={`${base}blog/`}>{month}</a>
                <span style="color: var(--color-muted); margin-left: 6px">({count})</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
